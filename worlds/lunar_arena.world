        <visual name="rim_v">
          <pose>0 0 0.001 0 0 0</pose>
          <geometry><cylinder><radius>0.55</radius><length>0.002</length></cylinder></geometry>
          <material>
            <ambient>0.42 0.40 0.37 1</ambient>
            <diffuse>0.74 0.70 0.64 1</diffuse>
            <specular>0.04 0.04 0.04 1</specular>
          </material>
        </visual>
        <!-- Floor (interior oscuro = sombra del cráter) -->
        <visual name="floor_v">
          <pose>0 0 0.003 0 0 0</pose>
          <geometry><cylinder><radius>0.38</radius><length>0.002</length></cylinder></geometry>
          <material>
