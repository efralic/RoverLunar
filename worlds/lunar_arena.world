<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="lunar_arena">

    <!-- ========================================================
         FÍSICA Y CONFIGURACIÓN GLOBAL
         ======================================================== -->
    <gravity>0 0 -9.81</gravity>
    <!-- Nota: la Luna tiene 1.62 m/s². Para simular luna real cambiar a -1.62 -->

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ========================================================
         ILUMINACIÓN
         ======================================================== -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.8 0.8 0.7 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Luz ambiente suave -->
    <light name="ambient" type="point">
      <pose>5 5 8 0 0 0</pose>
      <diffuse>0.3 0.3 0.35 1</diffuse>
      <specular>0 0 0 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- ========================================================
         PLANO BASE — ARENA LUNAR (10m x 10m x 0.10m)
         Centro en (5, 5, 0) → esquinas en (0,0) a (10,10)
         Zona INICIO en (1, 5) · Letrero FIN en (9, 5)
         ======================================================== -->
    <model name="lunar_ground">
      <static>true</static>
      <pose>5 5 -0.05 0 0 0</pose>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <box><size>10 10 0.1</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.6</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <box><size>10 10 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.55 0.52 0.50 1</ambient>
            <diffuse>0.55 0.52 0.50 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Paredes invisibles para que el rover no salga del área -->
    <model name="wall_north">
      <static>true</static>
      <pose>5 10.05 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>10 0.1 1</size></box></geometry></collision></link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>5 -0.05 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>10 0.1 1</size></box></geometry></collision></link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>10.05 5 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.1 10 1</size></box></geometry></collision></link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-0.05 5 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.1 10 1</size></box></geometry></collision></link>
    </model>

    <!-- ========================================================
         ZONA INICIO — marcador visual en el suelo
         ======================================================== -->
    <model name="start_marker">
      <static>true</static>
      <pose>1 5 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.6 0.6 0.002</size></box>
          </geometry>
          <material>
            <ambient>0 0.6 0 1</ambient>
            <diffuse>0 0.8 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="start_label">
      <static>true</static>
      <pose>1 5 0.3 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.08 0.25</size></box>
          </geometry>
          <material>
            <ambient>0 0.7 0 1</ambient>
            <diffuse>0 0.9 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================================
         CONTENEDOR DE MUESTRAS — 40cm x 60cm x 20cm
         Ubicado en la zona de INICIO
         ======================================================== -->
    <model name="sample_container">
      <static>true</static>
      <pose>1 4.2 0 0 0 0</pose>
      <link name="base">
        <collision name="floor_c"><geometry><box><size>0.6 0.4 0.02</size></box></geometry></collision>
        <visual name="floor_v">
          <pose>0 0 0.01 0 0 0</pose>
          <geometry><box><size>0.6 0.4 0.02</size></box></geometry>
          <material><ambient>0.1 0.1 0.8 1</ambient><diffuse>0.1 0.1 0.9 1</diffuse></material>
        </visual>
      </link>
      <!-- Paredes del contenedor -->
      <link name="wall_front">
        <pose>0.29 0 0.11 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.02 0.4 0.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.02 0.4 0.2</size></box></geometry>
          <material><ambient>0.1 0.1 0.8 0.7</ambient></material></visual>
      </link>
      <link name="wall_back">
        <pose>-0.29 0 0.11 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.02 0.4 0.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.02 0.4 0.2</size></box></geometry>
          <material><ambient>0.1 0.1 0.8 0.7</ambient></material></visual>
      </link>
      <link name="wall_left">
        <pose>0 0.19 0.11 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.6 0.02 0.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.02 0.2</size></box></geometry>
          <material><ambient>0.1 0.1 0.8 0.7</ambient></material></visual>
      </link>
      <link name="wall_right">
        <pose>0 -0.19 0.11 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.6 0.02 0.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.02 0.2</size></box></geometry>
          <material><ambient>0.1 0.1 0.8 0.7</ambient></material></visual>
      </link>
      <joint name="j1" type="fixed"><parent>base</parent><child>wall_front</child></joint>
      <joint name="j2" type="fixed"><parent>base</parent><child>wall_back</child></joint>
      <joint name="j3" type="fixed"><parent>base</parent><child>wall_left</child></joint>
      <joint name="j4" type="fixed"><parent>base</parent><child>wall_right</child></joint>
    </model>

    <!-- ========================================================
         LETRERO FIN — al otro extremo del campo (x=9, y=5)
         ======================================================== -->
    <model name="fin_sign_pole">
      <static>true</static>
      <pose>9 5 0 0 0 0</pose>
      <link name="pole">
        <collision name="c"><geometry><cylinder><radius>0.02</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="v">
          <pose>0 0 0.4 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
      <link name="sign_board">
        <pose>0 0 0.75 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.4 0.05 0.2</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.4 0.05 0.2</size></box></geometry>
          <material>
            <ambient>0.9 0.1 0.1 1</ambient>
            <diffuse>1.0 0.0 0.0 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="j" type="fixed"><parent>pole</parent><child>sign_board</child></joint>
    </model>

    <!-- ========================================================
         ACCIDENTES GEOGRÁFICOS

         VALLES (3): depresiones en el suelo
         SURCOS (3): canales angostos
         PENDIENTES (2): rampas de ~30°
         ======================================================== -->

    <!-- VALLE 1 — zona central izquierda -->
    <model name="valley_1">
      <static>true</static>
      <pose>4 3 -0.06 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.5 0.8 0.12</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.6</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>1.5 0.8 0.12</size></box></geometry>
          <material><ambient>0.45 0.42 0.40 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- VALLE 2 — zona central -->
    <model name="valley_2">
      <static>true</static>
      <pose>5 6.5 -0.06 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.2 1.0 0.12</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.6</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>1.2 1.0 0.12</size></box></geometry>
          <material><ambient>0.45 0.42 0.40 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- VALLE 3 — zona derecha -->
    <model name="valley_3">
      <static>true</static>
      <pose>7 3.5 -0.06 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 0.8 0.12</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.6</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>1.0 0.8 0.12</size></box></geometry>
          <material><ambient>0.45 0.42 0.40 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- SURCO 1 — diagonal zona norte -->
    <model name="groove_1">
      <static>true</static>
      <pose>3 7 -0.04 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.0 0.15 0.08</size></box></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.5</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>2.0 0.15 0.08</size></box></geometry>
          <material><ambient>0.40 0.37 0.35 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- SURCO 2 — horizontal centro -->
    <model name="groove_2">
      <static>true</static>
      <pose>5.5 5 -0.04 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.8 0.12 0.08</size></box></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.5</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>1.8 0.12 0.08</size></box></geometry>
          <material><ambient>0.40 0.37 0.35 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- SURCO 3 — zona sureste -->
    <model name="groove_3">
      <static>true</static>
      <pose>7.5 7 -0.04 0 0 0.5</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.5 0.12 0.08</size></box></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.5</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>1.5 0.12 0.08</size></box></geometry>
          <material><ambient>0.40 0.37 0.35 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- PENDIENTE 1 — rampa norte (~30°) -->
    <model name="slope_1">
      <static>true</static>
      <pose>3 2 0.18 0 -0.524 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1.5 1.2 0.04</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.7</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>1.5 1.2 0.04</size></box></geometry>
          <material><ambient>0.60 0.57 0.55 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- PENDIENTE 2 — rampa sur (~30°) -->
    <model name="slope_2">
      <static>true</static>
      <pose>7 8 0.18 0 0.524 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1.5 1.2 0.04</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.7</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>1.5 1.2 0.04</size></box></geometry>
          <material><ambient>0.60 0.57 0.55 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- ========================================================
         ROCAS — 10 rocas distribuidas en la arena
         Colores: ROJO (r), AZUL (b), VERDE (g)
         Tamaños aprox: 5, 7, 10, 12 cm³ → radio 0.01–0.015m
         ======================================================== -->

    <!-- Macro roca -->
    <!-- ROCA 1 — ROJA grande (12cm³) -->
    <model name="rock_1_red">
      <static>false</static>
      <pose>3.5 4.0 0.015 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.035</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
        <collision name="c"><geometry><sphere><radius>0.015</radius></sphere></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><sphere><radius>0.015</radius></sphere></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ROCA 2 — AZUL mediana (10cm³) -->
    <model name="rock_2_blue">
      <static>false</static>
      <pose>4.5 7.0 0.013 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.030</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
        <collision name="c"><geometry><sphere><radius>0.013</radius></sphere></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><sphere><radius>0.013</radius></sphere></geometry>
          <material><ambient>0.1 0.1 0.9 1</ambient><diffuse>0 0 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ROCA 3 — VERDE pequeña (7cm³) -->
    <model name="rock_3_green">
      <static>false</static>
      <pose>6.0 4.5 0.012 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.025</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
        <collision name="c"><geometry><sphere><radius>0.012</radius></sphere></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><sphere><radius>0.012</radius></sphere></geometry>
          <material><ambient>0.1 0.8 0.1 1</ambient><diffuse>0 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ROCA 4 — ROJA pequeña (5cm³) -->
    <model name="rock_4_red">
      <static>false</static>
      <pose>7.0 6.0 0.010 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.020</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
        <collision name="c"><geometry><sphere><radius>0.010</radius></sphere></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><sphere><radius>0.010</radius></sphere></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ROCA 5 — AZUL grande (12cm³) -->
    <model name="rock_5_blue">
      <static>false</static>
      <pose>5.5 2.5 0.015 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.040</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
        <collision name="c"><geometry><sphere><radius>0.015</radius></sphere></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><sphere><radius>0.015</radius></sphere></geometry>
          <material><ambient>0.1 0.1 0.9 1</ambient><diffuse>0 0 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ROCA 6 — VERDE mediana (10cm³) -->
    <model name="rock_6_green">
      <static>false</static>
      <pose>8.0 4.0 0.013 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.030</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
        <collision name="c"><geometry><sphere><radius>0.013</radius></sphere></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><sphere><radius>0.013</radius></sphere></geometry>
          <material><ambient>0.1 0.8 0.1 1</ambient><diffuse>0 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ROCA 7 — ROJA mediana (7cm³) -->
    <model name="rock_7_red">
      <static>false</static>
      <pose>2.5 7.5 0.012 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.025</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
        <collision name="c"><geometry><sphere><radius>0.012</radius></sphere></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><sphere><radius>0.012</radius></sphere></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ROCA 8 — AZUL pequeña (5cm³) -->
    <model name="rock_8_blue">
      <static>false</static>
      <pose>6.5 8.5 0.010 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.020</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
        <collision name="c"><geometry><sphere><radius>0.010</radius></sphere></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><sphere><radius>0.010</radius></sphere></geometry>
          <material><ambient>0.1 0.1 0.9 1</ambient><diffuse>0 0 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ROCA 9 — VERDE grande (12cm³) -->
    <model name="rock_9_green">
      <static>false</static>
      <pose>4.0 2.0 0.015 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.045</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
        <collision name="c"><geometry><sphere><radius>0.015</radius></sphere></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><sphere><radius>0.015</radius></sphere></geometry>
          <material><ambient>0.1 0.8 0.1 1</ambient><diffuse>0 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ROCA 10 — ROJA mediana (10cm³) -->
    <model name="rock_10_red">
      <static>false</static>
      <pose>8.5 7.5 0.013 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.030</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
        <collision name="c"><geometry><sphere><radius>0.013</radius></sphere></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><sphere><radius>0.013</radius></sphere></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ========================================================
         OBSTÁCULOS ADICIONALES — rocas grandes no recolectables
         ======================================================== -->
    <model name="obstacle_1">
      <static>true</static>
      <pose>4 5 0.08 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><sphere><radius>0.08</radius></sphere></geometry></collision>
        <visual name="v">
          <geometry><sphere><radius>0.08</radius></sphere></geometry>
          <material><ambient>0.5 0.48 0.46 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_2">
      <static>true</static>
      <pose>6.5 3 0.06 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><sphere><radius>0.06</radius></sphere></geometry></collision>
        <visual name="v">
          <geometry><sphere><radius>0.06</radius></sphere></geometry>
          <material><ambient>0.5 0.48 0.46 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_3">
      <static>true</static>
      <pose>7 7 0.07 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><sphere><radius>0.07</radius></sphere></geometry></collision>
        <visual name="v">
          <geometry><sphere><radius>0.07</radius></sphere></geometry>
          <material><ambient>0.5 0.48 0.46 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- ========================================================
         PLUGIN ROS — Gazebo ROS Factory (para spawning dinámico)
         ======================================================== -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
    </plugin>

    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
    </plugin>

  </world>
</sdf>
