    <!-- ========================================================
         CRÁTERES LUNARES — 6 cráteres transitables
         Diseño: discos finos pegados al suelo (no son hoyos reales)
           - Disco externo claro = "rim ejecta" del impacto
           - Disco interior oscuro = sombra del cráter
           - Pequeñas rocas eyecta alrededor para romper simetría
         Altura máxima ~5mm → el rover pasa por encima sin problema.
         ======================================================== -->

    <!-- CRÁTER 1 — GRANDE (R=0.55m) en (2.5, 3.5) -->
    <model name="crater_1">
      <static>true</static>
      <pose>2.5 3.5 0 0 0 0</pose>
      <link name="link">
