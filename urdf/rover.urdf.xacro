<?xml version="1.0"?>
<robot name="lunar_rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       ROVER LUNAR TMR 2026 — URDF v2 (física estable)
       Cambios vs v1:
       1. Ruedas reposicionadas (no penetran el suelo)
       2. Orugas son SOLO visuales (sin collision)
       3. Fricción reducida (mu=0.8 en vez de 1.5)
       4. kp reducido (100000 en vez de 500000)
       5. max_wheel_acceleration bajado (3.0 en vez de 10.0)
       ============================================================ -->

  <xacro:property name="PI" value="3.14159265"/>

  <!-- Chasis -->
  <xacro:property name="chassis_length" value="0.27"/>
  <xacro:property name="chassis_width"  value="0.205"/>
  <xacro:property name="chassis_height" value="0.10"/>
  <xacro:property name="chassis_mass"   value="3.5"/>

  <!-- Ruedas motrices -->
  <xacro:property name="wheel_radius"   value="0.0575"/>
  <xacro:property name="wheel_width"    value="0.04"/>
  <xacro:property name="wheel_mass"     value="0.2"/>

  <!-- Orugas (SOLO VISUALES ahora) -->
  <xacro:property name="track_length"   value="0.27"/>
  <xacro:property name="track_width"    value="0.04"/>
  <xacro:property name="track_height"   value="0.115"/>
  <xacro:property name="track_offset_y" value="0.1225"/>

  <!-- Brazo -->
  <xacro:property name="base_h"     value="0.095"/>
  <xacro:property name="upper_l"    value="0.115"/>
  <xacro:property name="forearm_l"  value="0.100"/>
  <xacro:property name="wrist_p_l"  value="0.030"/>
  <xacro:property name="wrist_r_l"  value="0.040"/>
  <xacro:property name="gripper_l"  value="0.030"/>

  <material name="dark_grey"><color rgba="0.2 0.2 0.2 1"/></material>
  <material name="light_grey"><color rgba="0.6 0.6 0.6 1"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
  <material name="orange"><color rgba="1.0 0.5 0.0 1"/></material>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12}" iyz="0"
               izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+h*h)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <!-- ============================================================
       BASE LINKS
       base_footprint = referencia en el suelo (z=0)
       base_link = chasis, elevado UN RADIO DE RUEDA sobre el suelo
       ============================================================ -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- base_link a la altura del centro de las ruedas -->
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       CHASIS PRINCIPAL
       ============================================================ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}"
                       x="${chassis_length}"
                       y="${chassis_width}"
                       z="${chassis_height}"/>
  </link>

  <!-- ============================================================
       ORUGAS — SOLO VISUALES (sin collision)
       Las "tracks" solo decoran. Las ruedas hacen el trabajo físico.
       ============================================================ -->
  <xacro:macro name="track" params="side reflect">
    <link name="track_${side}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${track_length} ${track_width} ${track_height}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <!-- NO collision aquí — orugas son visuales nomas -->
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.0001" ixy="0" ixz="0"
                 iyy="0.0001" iyz="0"
                 izz="0.0001"/>
      </inertial>
    </link>

    <joint name="track_${side}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="track_${side}"/>
      <!-- Centrada vertical respecto al chasis -->
      <origin xyz="0 ${reflect*track_offset_y} -0.0075" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:track side="left"  reflect="1"/>
  <xacro:track side="right" reflect="-1"/>

  <!-- ============================================================
       RUEDAS MOTRICES — únicos contactos con el suelo
       Centro de rueda a la altura de base_link (z=wheel_radius absoluto)
       Esto asegura que la rueda toque el suelo PERFECTAMENTE.
       ============================================================ -->
  <xacro:macro name="drive_wheel" params="side reflect">
    <link name="wheel_${side}">
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="wheel_${side}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${side}"/>
      <!-- z=0: centro de la rueda en la misma altura que base_link -->
      <!-- y: ligeramente fuera del chasis para que las orugas las cubran -->
      <origin xyz="0 ${reflect*(chassis_width/2 + 0.02)} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.1"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel side="left"  reflect="1"/>
  <xacro:drive_wheel side="right" reflect="-1"/>

  <!-- ============================================================
       SENSOR LIDAR — LD14P
       ============================================================ -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.1" r="0.035" h="0.04"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.08 0 ${chassis_height/2 + 0.02}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       CÁMARA RGB-D — AstraPro
       ============================================================ -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.16 0.03"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.06 0.16 0.03"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.08" x="0.06" y="0.16" z="0.03"/>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- Inclinación reducida a 0.1 rad (5.7 grados) — más estable visualmente -->
    <origin xyz="${chassis_length/2 - 0.01} 0 ${chassis_height/2 + 0.015}" rpy="0 0.1 0"/>
  </joint>

  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>

  <!-- ============================================================
       BRAZO ROBÓTICO — 6 DOF
       ============================================================ -->
  <link name="arm_base_link">
    <visual>
      <origin xyz="0 0 ${base_h/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="${base_h}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_h/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="${base_h}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.3" r="0.05" h="${base_h}"/>
  </link>

  <joint name="arm_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base_link"/>
    <origin xyz="${-chassis_length/2 + 0.08} 0 ${chassis_height/2}" rpy="0 0 0"/>
  </joint>

  <joint name="joint_1" type="revolute">
    <parent link="arm_base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 ${base_h}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-PI}" upper="${PI}" effort="9.4" velocity="3.14"/>
    <dynamics damping="0.05" friction="0.1"/>
  </joint>

  <link name="link_1">
    <visual>
      <origin xyz="0 0 ${upper_l/2}" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 ${upper_l}"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${upper_l/2}" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 ${upper_l}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.15" x="0.04" y="0.04" z="${upper_l}"/>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 ${upper_l}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-PI/2}" upper="${PI/2}" effort="9.4" velocity="3.14"/>
    <dynamics damping="0.05" friction="0.1"/>
  </joint>

  <link name="link_2">
    <visual>
      <origin xyz="${forearm_l/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry>
        <box size="0.035 0.035 ${forearm_l}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="${forearm_l/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry>
        <box size="0.035 0.035 ${forearm_l}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.12" x="${forearm_l}" y="0.035" z="0.035"/>
  </link>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="${forearm_l} 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-PI*2/3}" upper="${PI*2/3}" effort="9.4" velocity="3.14"/>
    <dynamics damping="0.05" friction="0.1"/>
  </joint>

  <link name="link_3">
    <visual>
      <origin xyz="${wrist_p_l/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry>
        <box size="0.03 0.03 ${wrist_p_l}"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <origin xyz="${wrist_p_l/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry>
        <box size="0.03 0.03 ${wrist_p_l}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.05" x="${wrist_p_l}" y="0.03" z="0.03"/>
  </link>

  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="${wrist_p_l} 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-PI/2}" upper="${PI/2}" effort="1.8" velocity="5.24"/>
    <dynamics damping="0.02" friction="0.05"/>
  </joint>

  <link name="link_4">
    <visual>
      <origin xyz="${wrist_r_l/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry>
        <cylinder radius="0.018" length="${wrist_r_l}"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="${wrist_r_l/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry>
        <cylinder radius="0.018" length="${wrist_r_l}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.04" r="0.018" h="${wrist_r_l}"/>
  </link>

  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="${wrist_r_l} 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="${-PI}" upper="${PI}" effort="1.8" velocity="5.24"/>
    <dynamics damping="0.02" friction="0.05"/>
  </joint>

  <link name="link_5">
    <visual>
      <origin xyz="${gripper_l/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry>
        <box size="0.025 0.04 ${gripper_l}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="${gripper_l/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry>
        <box size="0.025 0.04 ${gripper_l}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.03" x="${gripper_l}" y="0.04" z="0.025"/>
  </link>

  <joint name="joint_6" type="revolute">
    <parent link="link_5"/>
    <child link="gripper_link"/>
    <origin xyz="${gripper_l} 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="${PI/3}" effort="1.8" velocity="5.24"/>
    <dynamics damping="0.01" friction="0.02"/>
  </joint>

  <link name="gripper_link">
    <visual>
      <origin xyz="0.02 0.01 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.008 0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0.02 0.01 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.008 0.02"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.015" x="0.04" y="0.008" z="0.02"/>
  </link>

  <link name="tcp_link"/>
  <joint name="tcp_joint" type="fixed">
    <parent link="gripper_link"/>
    <child link="tcp_link"/>
    <origin xyz="0.045 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       PLUGINS GAZEBO
       ============================================================ -->

  <!-- Diff drive: aceleración reducida a 3.0 m/s2 (era 10.0) -->
  <gazebo>
    <plugin name="differential_drive_controller"
            filename="libgazebo_ros_diff_drive.so">
      <ros><namespace>/rover</namespace></ros>
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.245</wheel_separation>
      <wheel_diameter>0.115</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>3.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- LIDAR -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>${-PI}</min_angle>
            <max_angle>${PI}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/rover</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Cámara RGB -->
  <gazebo reference="camera_link">
    <sensor name="camera_rgb" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.089</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.05</near><far>10.0</far></clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </camera>
      <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/rover</namespace>
          <remapping>image_raw:=camera/image_raw</remapping>
          <remapping>camera_info:=camera/camera_info</remapping>
        </ros>
        <frame_name>camera_optical_link</frame_name>
      </plugin>
    </sensor>

    <sensor name="camera_depth" type="depth">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.089</horizontal_fov>
        <image><width>640</width><height>480</height></image>
        <clip><near>0.1</near><far>8.0</far></clip>
      </camera>
      <plugin name="depth_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/rover</namespace>
          <remapping>image_raw:=depth/image_raw</remapping>
          <remapping>camera_info:=depth/camera_info</remapping>
          <remapping>points:=depth/points</remapping>
        </ros>
        <frame_name>camera_optical_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- IMU -->
  <gazebo reference="base_link">
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/rover</namespace>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <frame_name>base_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ============================================================
       MATERIALES Y FRICCIÓN
       Orugas visuales (sin contacto físico, solo apariencia)
       Ruedas con fricción REALISTA (mu=0.8) y contacto menos rígido
       ============================================================ -->
  <gazebo reference="track_left">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="track_right">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="wheel_left">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>100000</kp>
    <kd>10</kd>
    <fdir1>1 0 0</fdir1>
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="wheel_right">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>100000</kp>
    <kd>10</kd>
    <fdir1>1 0 0</fdir1>
    <material>Gazebo/Black</material>
  </gazebo>

</robot>
