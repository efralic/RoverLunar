<?xml version="1.0"?>
<robot name="lunar_rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       ROVER LUNAR TMR 2026
       Chasis: 27cm x 20.5cm x 10cm  (orugas diferenciales)
       Brazo:  6 DOF (MG996R x3 + MG90S x3)
         - a = 9.5cm  base
         - b = 11.5cm upper arm
         - c = 10cm   forearm
         - d = 3cm    wrist_pitch
         - e = 7cm    wrist_roll + gripper
       ============================================================ -->

  <!-- Propiedades globales -->
  <xacro:property name="PI" value="3.14159265"/>

  <!-- Chasis -->
  <xacro:property name="chassis_length" value="0.27"/>
  <xacro:property name="chassis_width"  value="0.205"/>
  <xacro:property name="chassis_height" value="0.10"/>
  <xacro:property name="chassis_mass"   value="3.0"/>

  <!-- Orugas (representadas como cajas planas) -->
  <xacro:property name="track_length"   value="0.27"/>
  <xacro:property name="track_width"    value="0.04"/>
  <xacro:property name="track_height"   value="0.115"/>
  <xacro:property name="track_offset_y" value="0.1225"/>

  <!-- Brazo -->
  <xacro:property name="base_h"     value="0.095"/>   <!-- a -->
  <xacro:property name="upper_l"    value="0.115"/>   <!-- b -->
  <xacro:property name="forearm_l"  value="0.100"/>   <!-- c -->
  <xacro:property name="wrist_p_l"  value="0.030"/>   <!-- d -->
  <xacro:property name="wrist_r_l"  value="0.040"/>   <!-- e/2 -->
  <xacro:property name="gripper_l"  value="0.030"/>   <!-- e/2 -->

  <!-- Colores Gazebo -->
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1"/>
  </material>
  <material name="light_grey">
    <color rgba="0.6 0.6 0.6 1"/>
  </material>
  <material name="black">
    <color rgba="0.05 0.05 0.05 1"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.5 0.0 1"/>
  </material>

  <!-- ============================================================
       MACRO: Inercia de caja
       ============================================================ -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12}" iyz="0"
               izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+h*h)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <!-- ============================================================
       BASE LINK (referencia del robot)
       ============================================================ -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${track_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       CHASIS PRINCIPAL
       ============================================================ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}"
                       x="${chassis_length}"
                       y="${chassis_width}"
                       z="${chassis_height}"/>
  </link>

  <!-- ============================================================
       ORUGAS — izquierda y derecha (visuales + colisión)
       ============================================================ -->
  <xacro:macro name="track" params="side reflect">
    <link name="track_${side}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${track_length} ${track_width} ${track_height}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${track_length} ${track_width} ${track_height}"/>
        </geometry>
      </collision>
      <xacro:box_inertia m="0.3" x="${track_length}" y="${track_width}" z="${track_height}"/>
    </link>

    <joint name="track_${side}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="track_${side}"/>
      <origin xyz="0 ${reflect*track_offset_y} ${-(chassis_height/2 - track_height/2 + 0.005)}"
              rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:track side="left"  reflect="1"/>
  <xacro:track side="right" reflect="-1"/>

  <!-- ============================================================
       RUEDAS MOTRICES — izquierda y derecha (para differential drive)
       Gazebo las usa internamente para calcular movimiento
       ============================================================ -->
  <xacro:macro name="drive_wheel" params="side reflect">
    <link name="wheel_${side}">
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="0.0575" length="0.04"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="0.0575" length="0.04"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="0.2" r="0.0575" h="0.04"/>
    </link>

    <joint name="wheel_${side}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${side}"/>
      <origin xyz="0 ${reflect*(chassis_width/2 + 0.02)} ${-chassis_height/2 + 0.005}"
              rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.5"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel side="left"  reflect="1"/>
  <xacro:drive_wheel side="right" reflect="-1"/>

  <!-- ============================================================
       SENSOR LIDAR — LD14P
       Montado encima del chasis, al frente-centro
       ============================================================ -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.1" r="0.035" h="0.04"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.08 0 ${chassis_height/2 + 0.02}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       CÁMARA RGB-D — AstraPro (frontal)
       ============================================================ -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.16 0.03"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.06 0.16 0.03"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.08" x="0.06" y="0.16" z="0.03"/>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${chassis_length/2 - 0.01} 0 ${chassis_height/2 + 0.015}" rpy="0 0.2 0"/>
  </joint>

  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>

  <!-- ============================================================
       BRAZO ROBÓTICO — 6 DOF (diseño propio)
       Montado en la parte trasera-centro del chasis
       ============================================================ -->

  <!-- --- LINK 0: Base fija del brazo sobre el chasis --- -->
  <link name="arm_base_link">
    <visual>
      <origin xyz="0 0 ${base_h/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="${base_h}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_h/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="${base_h}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.3" r="0.05" h="${base_h}"/>
  </link>

  <joint name="arm_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base_link"/>
    <origin xyz="${-chassis_length/2 + 0.08} 0 ${chassis_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- --- JOINT 1: Rotación base (yaw) — MG996R --- -->
  <joint name="joint_1" type="revolute">
    <parent link="arm_base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 ${base_h}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-PI}" upper="${PI}" effort="9.4" velocity="3.14"/>
    <dynamics damping="0.05" friction="0.1"/>
  </joint>

  <!-- --- LINK 1: Hombro (upper arm b=11.5cm) --- -->
  <link name="link_1">
    <visual>
      <origin xyz="0 0 ${upper_l/2}" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 ${upper_l}"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${upper_l/2}" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 ${upper_l}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.15" x="0.04" y="0.04" z="${upper_l}"/>
  </link>

  <!-- --- JOINT 2: Hombro (pitch) — MG996R --- -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 ${upper_l}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-PI/2}" upper="${PI/2}" effort="9.4" velocity="3.14"/>
    <dynamics damping="0.05" friction="0.1"/>
  </joint>

  <!-- --- LINK 2: Codo (forearm c=10cm) --- -->
  <link name="link_2">
    <visual>
      <origin xyz="${forearm_l/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry>
        <box size="0.035 0.035 ${forearm_l}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="${forearm_l/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry>
        <box size="0.035 0.035 ${forearm_l}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.12" x="${forearm_l}" y="0.035" z="0.035"/>
  </link>

  <!-- --- JOINT 3: Codo (pitch) — MG996R --- -->
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="${forearm_l} 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-PI*2/3}" upper="${PI*2/3}" effort="9.4" velocity="3.14"/>
    <dynamics damping="0.05" friction="0.1"/>
  </joint>

  <!-- --- LINK 3: Muñeca pitch (d=3cm) --- -->
  <link name="link_3">
    <visual>
      <origin xyz="${wrist_p_l/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry>
        <box size="0.03 0.03 ${wrist_p_l}"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <origin xyz="${wrist_p_l/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry>
        <box size="0.03 0.03 ${wrist_p_l}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.05" x="${wrist_p_l}" y="0.03" z="0.03"/>
  </link>

  <!-- --- JOINT 4: Muñeca pitch — MG90S --- -->
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="${wrist_p_l} 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-PI/2}" upper="${PI/2}" effort="1.8" velocity="5.24"/>
    <dynamics damping="0.02" friction="0.05"/>
  </joint>

  <!-- --- LINK 4: Muñeca roll --- -->
  <link name="link_4">
    <visual>
      <origin xyz="${wrist_r_l/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry>
        <cylinder radius="0.018" length="${wrist_r_l}"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="${wrist_r_l/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry>
        <cylinder radius="0.018" length="${wrist_r_l}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.04" r="0.018" h="${wrist_r_l}"/>
  </link>

  <!-- --- JOINT 5: Muñeca roll — MG90S --- -->
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="${wrist_r_l} 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="${-PI}" upper="${PI}" effort="1.8" velocity="5.24"/>
    <dynamics damping="0.02" friction="0.05"/>
  </joint>

  <!-- --- LINK 5: Conector gripper --- -->
  <link name="link_5">
    <visual>
      <origin xyz="${gripper_l/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry>
        <box size="0.025 0.04 ${gripper_l}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="${gripper_l/2} 0 0" rpy="0 ${PI/2} 0"/>
      <geometry>
        <box size="0.025 0.04 ${gripper_l}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.03" x="${gripper_l}" y="0.04" z="0.025"/>
  </link>

  <!-- --- JOINT 6: Apertura del gripper — MG90S --- -->
  <joint name="joint_6" type="revolute">
    <parent link="link_5"/>
    <child link="gripper_link"/>
    <origin xyz="${gripper_l} 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="${PI/3}" effort="1.8" velocity="5.24"/>
    <dynamics damping="0.01" friction="0.02"/>
  </joint>

  <!-- --- LINK GRIPPER --- -->
  <link name="gripper_link">
    <visual>
      <origin xyz="0.02 0.01 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.008 0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0.02 0.01 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.008 0.02"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.015" x="0.04" y="0.008" z="0.02"/>
  </link>

  <!-- Frame del efector final (tool center point) -->
  <link name="tcp_link"/>
  <joint name="tcp_joint" type="fixed">
    <parent link="gripper_link"/>
    <child link="tcp_link"/>
    <origin xyz="0.045 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       PLUGINS DE GAZEBO
       ============================================================ -->

  <!-- Plugin differential drive (simula movimiento de orugas) -->
  <gazebo>
    <plugin name="differential_drive_controller"
            filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/rover</namespace>
      </ros>
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>${chassis_width + 0.04}</wheel_separation>
      <wheel_diameter>0.115</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>10.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- Plugin LIDAR LD14P (simulado como RPLidar 360°) -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>${-PI}</min_angle>
            <max_angle>${PI}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/rover</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Plugin Cámara RGB (AstraPro - canal color) -->
  <gazebo reference="camera_link">
    <sensor name="camera_rgb" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.089</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </camera>
      <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/rover</namespace>
          <remapping>image_raw:=camera/image_raw</remapping>
          <remapping>camera_info:=camera/camera_info</remapping>
        </ros>
        <frame_name>camera_optical_link</frame_name>
      </plugin>
    </sensor>

    <!-- Plugin Profundidad (AstraPro - canal depth) -->
    <sensor name="camera_depth" type="depth">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.089</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>8.0</far>
        </clip>
      </camera>
      <plugin name="depth_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/rover</namespace>
          <remapping>image_raw:=depth/image_raw</remapping>
          <remapping>camera_info:=depth/camera_info</remapping>
          <remapping>points:=depth/points</remapping>
        </ros>
        <frame_name>camera_optical_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Plugin IMU (SensorTile) -->
  <gazebo reference="base_link">
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/rover</namespace>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <frame_name>base_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Material orugas -->
  <gazebo reference="track_left">
    <mu1>0.9</mu1><mu2>0.9</mu2>
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="track_right">
    <mu1>0.9</mu1><mu2>0.9</mu2>
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- Fricción ruedas sobre arena -->
  <gazebo reference="wheel_left">
    <mu1>1.5</mu1><mu2>1.5</mu2>
    <kp>500000</kp><kd>10</kd>
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="wheel_right">
    <mu1>1.5</mu1><mu2>1.5</mu2>
    <kp>500000</kp><kd>10</kd>
    <material>Gazebo/Black</material>
  </gazebo>

</robot>
